{
  "description": "kelpie: a delegation triage on every prompt, in prefer mode unless configured otherwise, and a per-spawn gate on Workflow calls that stays off without a Jev key.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/hooks/delegation-triage/triage.mjs",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Workflow",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}\"/hooks/jev-gate/gate.mjs",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
